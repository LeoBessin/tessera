{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,

    /* Internal packages are consumed as TypeScript source and bundled by the
     * app that uses them (Vite for the client, tsdown for the server), so no
     * package ever emits JavaScript. `tsc` is a type checker here, nothing more. */
    "noEmit": true,

    /* Strictness is non-negotiable: the simulation's correctness guarantees
     * rest on the type system as much as on the tests. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  }
}
