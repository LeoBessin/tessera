{
  "name": "tessera",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "pnpm -r --parallel typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "verify": "pnpm typecheck && pnpm arch && pnpm test",
    "replay:bless": "node scripts/bless-replays.ts"
  },
  "devDependencies": {
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
